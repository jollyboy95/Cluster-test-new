<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Standard Android Automotive permissions for reading live speed/RPM via android.car -
         public AAOS API, not GWM's private adapter. See VehicleDataSource.java. -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_ENGINE_DETAILED" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- Standard AAOS permission for CarNavigationStatusManager.getInstrumentClusterInfo() -
         a public, non-privileged READ of whatever cluster capabilities the registered renderer
         (GWM's own service) has advertised. Confirmed "normal" protection level in AOSP. Never
         used to call sendNavigationStateChange() or inject guidance data. See
         NavigationRendererProbe and docs/H7_DISPLAY_ARCHITECTURE.md. -->
    <uses-permission android:name="android.car.permission.CAR_NAVIGATION_MANAGER" />
    <!-- Shizuku's own permission, checked by Shizuku.checkSelfPermission()/requestPermission()
         once the app is authorized in the Shizuku app. See GwmLogcatVehicleDataSource. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- GWM's own adapter data permission. Confirmed present (via GwmAdapterServer.apk's own
         manifest) and confirmed used as the PRIMARY data path by two independent third-party
         cluster apps (com.tank.priborka, net.adminrunet.h9cluster) rather than a fallback -
         SmartSplit's own string "gwm_adapter unavailable or permission denied" suggests it's
         sometimes denied, which is exactly what this probe is for. Declaring it here does not
         grant it - MainActivity's "Check GET_DATA permission" button checks/requests it the
         normal Android runtime-permission way and reports the real protectionLevel straight
         from this device's own PackageManager. Read-only data permission; unrelated to the
         signature-protected car.ipk_setting.* write interface this project stays away from. -->
    <uses-permission android:name="com.gwm.android.adapter.permission.GET_DATA" />

    <!-- v0.26: Android Auto receiver (experimental, disabled by default - see
         com.clusterprobe.aareceiver.AndroidAutoReceiver and docs/H7_DISPLAY_ARCHITECTURE.md).
         USB host capability is needed to negotiate AOAP with an attached phone. required="false"
         so this manifest declaration can never block install on a build without it - this head
         unit's existing wired-AA-to-GWM's-receiver behavior already implies it has USB host, but
         this doesn't assume that. No <uses-permission> needed for USB device access itself - that
         permission is granted per-device at runtime via UsbManager.requestPermission(), the same
         flow this feature uses. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <!-- v0.32: wireless AA bootstrap (experimental, disabled by default - same master toggle as
         the USB receiver above; see com.clusterprobe.aareceiver.AaWirelessBootstrapServer and
         docs/H7_DISPLAY_ARCHITECTURE.md's "v0.32: wireless bootstrap" section). targetSdk 28, so
         the legacy BLUETOOTH/BLUETOOTH_ADMIN permissions (not the API 31+ BLUETOOTH_CONNECT/
         BLUETOOTH_ADVERTISE/BLUETOOTH_SCAN split) are what this device actually enforces - these
         are install-time-granted on API 28, no runtime request needed for them specifically.
         ACCESS_FINE_LOCATION IS a runtime permission on API 28 and is required by
         WifiManager.startLocalOnlyHotspot() - requested at runtime by the diagnostic screen before
         this feature's button does anything, never assumed granted. Does not touch Bluetooth
         discovery/pairing - the phone must already be paired with this head unit the normal way;
         this only advertises one RFCOMM service (AaWirelessConstants.AAWG_PROFILE_UUID) and hosts
         a local Wi-Fi AP, both ordinary non-privileged app capabilities. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <application
        android:label="ClusterProbe"
        android:allowBackup="false"
        android:hardwareAccelerated="true">
        <uses-library android:name="android.car" android:required="false" />

        <!-- Shizuku transport - lets this app receive the shell-UID binder once the user
             authorizes it in the Shizuku app, so GwmLogcatUserService can run `logcat` under
             shell UID. Read-only data path; see GwmLogcatVehicleDataSource. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ClusterActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />
        <activity
            android:name=".aareceiver.AndroidAutoSessionActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- v0.40: the same standing capability SmartSplit/Kafo Themes both declare and rely on
             for cluster/split-screen work (BIND_ACCESSIBILITY_SERVICE), configured programmatically
             in ClusterProbeDashboardService.onServiceConnected() rather than via a meta-data XML
             resource, since this project has no res/ resource tree yet. Declaring it here does not
             turn it on - like SmartSplit/Kafo, the user must enable "ClusterProbe Dashboard" in
             system Settings > Accessibility before Android will ever instantiate this class. See
             the class's own doc comment for what it is and isn't doing yet. -->
        <service
            android:name=".ClusterProbeDashboardService"
            android:label="ClusterProbe Dashboard"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
        </service>
    </application>
</manifest>
