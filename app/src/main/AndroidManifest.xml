<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Standard Android Automotive permissions for reading live speed/RPM via android.car -
         public AAOS API, not GWM's private adapter. See VehicleDataSource.java. -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_ENGINE_DETAILED" />
    <uses-permission android:name="android.car.permission.CAR_ENERGY" />
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- Standard AAOS permission for CarNavigationStatusManager.getInstrumentClusterInfo() -
         a public, non-privileged READ of whatever cluster capabilities the registered renderer
         (GWM's own service) has advertised. Confirmed "normal" protection level in AOSP. Never
         used to call sendNavigationStateChange() or inject guidance data. See
         NavigationRendererProbe and docs/H7_DISPLAY_ARCHITECTURE.md. -->
    <uses-permission android:name="android.car.permission.CAR_NAVIGATION_MANAGER" />
    <!-- Shizuku's own permission, checked by Shizuku.checkSelfPermission()/requestPermission()
         once the app is authorized in the Shizuku app. See GwmLogcatVehicleDataSource. -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- GWM's own adapter data permission. Confirmed present (via GwmAdapterServer.apk's own
         manifest) and confirmed used as the PRIMARY data path by two independent third-party
         cluster apps (com.tank.priborka, net.adminrunet.h9cluster) rather than a fallback -
         SmartSplit's own string "gwm_adapter unavailable or permission denied" suggests it's
         sometimes denied, which is exactly what this probe is for. Declaring it here does not
         grant it - MainActivity's "Check GET_DATA permission" button checks/requests it the
         normal Android runtime-permission way and reports the real protectionLevel straight
         from this device's own PackageManager. Read-only data permission; unrelated to the
         signature-protected car.ipk_setting.* write interface this project stays away from. -->
    <uses-permission android:name="com.gwm.android.adapter.permission.GET_DATA" />
    <application
        android:label="ClusterProbe"
        android:allowBackup="false"
        android:hardwareAccelerated="true">
        <uses-library android:name="android.car" android:required="false" />

        <!-- Shizuku transport - lets this app receive the shell-UID binder once the user
             authorizes it in the Shizuku app, so GwmLogcatUserService can run `logcat` under
             shell UID. Read-only data path; see GwmLogcatVehicleDataSource. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ClusterActivity"
            android:exported="false"
            android:resizeableActivity="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />
    </application>
</manifest>
